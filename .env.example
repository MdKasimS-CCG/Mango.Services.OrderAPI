# OrderAPI — environment variables (all profiles)
# HTTP/local profile (DOTNET_RUNNING_IN_CONTAINER != true)

Http__ConnectionStrings__DefaultConnection=
Http__ServiceUrls__ProductAPI=

# Docker profile (DOTNET_RUNNING_IN_CONTAINER=true)
# DB: host.docker.internal → sqlserver (Compose service DNS name)
# ProductAPI: mango.services.productapi → mango-product (matches docker-compose container_name)

Docker__ConnectionStrings__DefaultConnection=
Docker__ServiceUrls__ProductAPI=

# Common settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ApiSettings__Secret=
ApiSettings__Issuer=
ApiSettings__Audience=

# RabbitMQ producer — read by RabbitMQMessageProducer via MessageQueue:RabbitMQ:HostName
# OrderAPI uses AddEnvironmentVariables() (no prefix stripping); use flat keys

MessageQueue__RabbitMQ__HostName=
MessageQueue__RabbitMQ__UserName=
MessageQueue__RabbitMQ__Password=

TopicAndQueueNames__OrderCreatedEmailQueue=emailordercreated
TopicAndQueueNames__OrderCreatedRewardQueue=rewardordercreated
MessageQueue__RabbitMQ__Port=5672